<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<!--
  The app's settings that Xcode cannot write from the project's build settings.
  Xcode adds everything else (the app's name, the microphone question, Files app sharing)
  when it builds; see project.pbxproj.

  UIBackgroundModes / audio: walk-up and warm-up songs keep playing when the phone locks
  or the scorer switches apps.
-->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
